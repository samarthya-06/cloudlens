server {
    listen 80;
    server_name _;
    root /usr/share/nginx/html;
    server_tokens off;
    access_log off;
    client_max_body_size 2m;
    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy same-origin always;
    add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; font-src 'self'; img-src 'self' data:; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'" always;
    # CloudFront supplies this header; inject its value through restricted origin.env.
    if ($http_x_cloudlens_origin != "${ORIGIN_SECRET}") { return 403; }
    location /api/ {
        proxy_pass http://api:8000;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_connect_timeout 5s;
        proxy_read_timeout 20s;
    }
    location / { try_files $uri $uri/ /index.html; }
}
