{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "CloudLens Gemini-powered classroom demo: single EC2 host, private S3, CloudWatch and protected CloudFront HTTPS entry.",
  "Parameters": {
    "AmiId": {
      "Type": "AWS::SSM::Parameter::Value<AWS::EC2::Image::Id>",
      "Default": "/aws/service/ami-amazon-linux-latest/al2023-ami-kernel-default-x86_64"
    },
    "InstanceType": {
      "Type": "String",
      "Default": "t3.small",
      "AllowedValues": [
        "t3.small",
        "t3.medium"
      ]
    },
    "CloudFrontPrefixListId": {
      "Type": "String",
      "Description": "Mumbai com.amazonaws.global.cloudfront.origin-facing managed prefix list"
    }
  },
  "Resources": {
    "VPC": {
      "Type": "AWS::EC2::VPC",
      "Properties": {
        "CidrBlock": "10.42.0.0/16",
        "EnableDnsSupport": true,
        "EnableDnsHostnames": true,
        "Tags": [
          {
            "Key": "Project",
            "Value": "CloudLens"
          }
        ]
      }
    },
    "InternetGateway": {
      "Type": "AWS::EC2::InternetGateway",
      "Properties": {
        "Tags": [
          {
            "Key": "Project",
            "Value": "CloudLens"
          }
        ]
      }
    },
    "GatewayAttachment": {
      "Type": "AWS::EC2::VPCGatewayAttachment",
      "Properties": {
        "VpcId": {
          "Ref": "VPC"
        },
        "InternetGatewayId": {
          "Ref": "InternetGateway"
        }
      }
    },
    "Subnet": {
      "Type": "AWS::EC2::Subnet",
      "Properties": {
        "VpcId": {
          "Ref": "VPC"
        },
        "CidrBlock": "10.42.1.0/24",
        "MapPublicIpOnLaunch": true,
        "Tags": [
          {
            "Key": "Project",
            "Value": "CloudLens"
          }
        ]
      }
    },
    "RouteTable": {
      "Type": "AWS::EC2::RouteTable",
      "Properties": {
        "VpcId": {
          "Ref": "VPC"
        },
        "Tags": [
          {
            "Key": "Project",
            "Value": "CloudLens"
          }
        ]
      }
    },
    "DefaultRoute": {
      "Type": "AWS::EC2::Route",
      "Properties": {
        "RouteTableId": {
          "Ref": "RouteTable"
        },
        "DestinationCidrBlock": "0.0.0.0/0",
        "GatewayId": {
          "Ref": "InternetGateway"
        }
      },
      "DependsOn": "GatewayAttachment"
    },
    "RouteAssociation": {
      "Type": "AWS::EC2::SubnetRouteTableAssociation",
      "Properties": {
        "SubnetId": {
          "Ref": "Subnet"
        },
        "RouteTableId": {
          "Ref": "RouteTable"
        }
      }
    },
    "OriginSecurityGroup": {
      "Type": "AWS::EC2::SecurityGroup",
      "Properties": {
        "VpcId": {
          "Ref": "VPC"
        },
        "GroupDescription": "CloudLens HTTP origin from CloudFront only; management through SSM",
        "SecurityGroupIngress": [
          {
            "IpProtocol": "tcp",
            "FromPort": 80,
            "ToPort": 80,
            "SourcePrefixListId": {
              "Ref": "CloudFrontPrefixListId"
            }
          }
        ],
        "Tags": [
          {
            "Key": "Project",
            "Value": "CloudLens"
          }
        ]
      }
    },
    "Artifacts": {
      "Type": "AWS::S3::Bucket",
      "Properties": {
        "PublicAccessBlockConfiguration": {
          "BlockPublicAcls": true,
          "IgnorePublicAcls": true,
          "BlockPublicPolicy": true,
          "RestrictPublicBuckets": true
        },
        "BucketEncryption": {
          "ServerSideEncryptionConfiguration": [
            {
              "ServerSideEncryptionByDefault": {
                "SSEAlgorithm": "AES256"
              }
            }
          ]
        },
        "OwnershipControls": {
          "Rules": [
            {
              "ObjectOwnership": "BucketOwnerEnforced"
            }
          ]
        },
        "LifecycleConfiguration": {
          "Rules": [
            {
              "Id": "DemoReportRetention",
              "Status": "Enabled",
              "Prefix": "cloudlens/reports/",
              "ExpirationInDays": 7,
              "NoncurrentVersionExpiration": {
                "NoncurrentDays": 7
              }
            }
          ]
        },
        "Tags": [
          {
            "Key": "Project",
            "Value": "CloudLens"
          }
        ],
        "VersioningConfiguration": {
          "Status": "Enabled"
        }
      },
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain"
    },
    "BucketTransportPolicy": {
      "Type": "AWS::S3::BucketPolicy",
      "Properties": {
        "Bucket": {
          "Ref": "Artifacts"
        },
        "PolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Deny",
              "Principal": "*",
              "Action": "s3:*",
              "Resource": [
                {
                  "Fn::GetAtt": [
                    "Artifacts",
                    "Arn"
                  ]
                },
                {
                  "Fn::Sub": "${Artifacts.Arn}/*"
                }
              ],
              "Condition": {
                "Bool": {
                  "aws:SecureTransport": "false"
                }
              }
            }
          ]
        }
      }
    },
    "ApplicationLogs": {
      "Type": "AWS::Logs::LogGroup",
      "Properties": {
        "LogGroupName": "/cloudlens/application",
        "RetentionInDays": 7,
        "Tags": [
          {
            "Key": "Project",
            "Value": "CloudLens"
          }
        ]
      }
    },
    "InstanceRole": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "Tags": [
          {
            "Key": "Project",
            "Value": "CloudLens"
          }
        ],
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "Service": "ec2.amazonaws.com"
              },
              "Action": "sts:AssumeRole"
            }
          ]
        },
        "ManagedPolicyArns": [
          {
            "Fn::Sub": "arn:${AWS::Partition}:iam::aws:policy/AmazonSSMManagedInstanceCore"
          }
        ],
        "Policies": [
          {
            "PolicyName": "CloudLensRuntime",
            "PolicyDocument": {
              "Version": "2012-10-17",
              "Statement": [
                {
                  "Effect": "Allow",
                  "Action": [
                    "s3:GetObject",
                    "s3:PutObject"
                  ],
                  "Resource": {
                    "Fn::Sub": "${Artifacts.Arn}/cloudlens/*"
                  }
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "logs:CreateLogStream",
                    "logs:PutLogEvents",
                    "logs:DescribeLogStreams"
                  ],
                  "Resource": {
                    "Fn::GetAtt": [
                      "ApplicationLogs",
                      "Arn"
                    ]
                  }
                },
                {
                  "Effect": "Allow",
                  "Action": "secretsmanager:GetSecretValue",
                  "Resource": {
                    "Ref": "OriginSecret"
                  }
                }
              ]
            }
          }
        ]
      }
    },
    "InstanceProfile": {
      "Type": "AWS::IAM::InstanceProfile",
      "Properties": {
        "Roles": [
          {
            "Ref": "InstanceRole"
          }
        ]
      }
    },
    "Instance": {
      "Type": "AWS::EC2::Instance",
      "Properties": {
        "ImageId": {
          "Ref": "AmiId"
        },
        "InstanceType": {
          "Ref": "InstanceType"
        },
        "IamInstanceProfile": {
          "Ref": "InstanceProfile"
        },
        "SubnetId": {
          "Ref": "Subnet"
        },
        "SecurityGroupIds": [
          {
            "Ref": "OriginSecurityGroup"
          }
        ],
        "MetadataOptions": {
          "HttpTokens": "required",
          "HttpPutResponseHopLimit": 2
        },
        "BlockDeviceMappings": [
          {
            "DeviceName": "/dev/xvda",
            "Ebs": {
              "VolumeSize": 12,
              "VolumeType": "gp3",
              "Encrypted": true,
              "DeleteOnTermination": true
            }
          }
        ],
        "UserData": {
          "Fn::Base64": "#!/bin/bash\nset -eu\ndnf install -y docker\nsystemctl enable --now docker\nmkdir -p /srv/cloudlens/runtime /srv/cloudlens/source\nchown -R 10001:10001 /srv/cloudlens/runtime\n# No credentials, passwords or origin secret are stored in user-data.\n"
        },
        "Tags": [
          {
            "Key": "Project",
            "Value": "CloudLens"
          }
        ],
        "CreditSpecification": {
          "CPUCredits": "standard"
        }
      },
      "DependsOn": [
        "DefaultRoute",
        "RouteAssociation"
      ]
    },
    "Distribution": {
      "Type": "AWS::CloudFront::Distribution",
      "Properties": {
        "Tags": [
          {
            "Key": "Project",
            "Value": "CloudLens"
          }
        ],
        "DistributionConfig": {
          "Enabled": true,
          "Comment": "CloudLens protected classroom demo",
          "DefaultRootObject": "index.html",
          "PriceClass": "PriceClass_200",
          "HttpVersion": "http2",
          "Origins": [
            {
              "Id": "ec2",
              "DomainName": {
                "Fn::GetAtt": [
                  "Instance",
                  "PublicDnsName"
                ]
              },
              "OriginCustomHeaders": [
                {
                  "HeaderName": "X-CloudLens-Origin",
                  "HeaderValue": {
                    "Fn::Sub": "{{resolve:secretsmanager:${OriginSecret}:SecretString:header}}"
                  }
                }
              ],
              "CustomOriginConfig": {
                "OriginProtocolPolicy": "http-only",
                "HTTPPort": 80
              }
            }
          ],
          "DefaultCacheBehavior": {
            "TargetOriginId": "ec2",
            "ViewerProtocolPolicy": "redirect-to-https",
            "AllowedMethods": [
              "GET",
              "HEAD"
            ],
            "CachedMethods": [
              "GET",
              "HEAD"
            ],
            "CachePolicyId": "658327ea-f89d-4fab-a63d-7e88639e58f6",
            "Compress": true
          },
          "CacheBehaviors": [
            {
              "PathPattern": "/api/*",
              "TargetOriginId": "ec2",
              "ViewerProtocolPolicy": "redirect-to-https",
              "AllowedMethods": [
                "GET",
                "HEAD",
                "OPTIONS",
                "PUT",
                "PATCH",
                "POST",
                "DELETE"
              ],
              "CachedMethods": [
                "GET",
                "HEAD"
              ],
              "CachePolicyId": "4135ea2d-6df8-44a3-9df3-4b5a84be39ad",
              "OriginRequestPolicyId": "b689b0a8-53d0-40ab-baf2-68738e2966ac",
              "Compress": true
            }
          ],
          "ViewerCertificate": {
            "CloudFrontDefaultCertificate": true
          }
        }
      }
    },
    "OriginSecret": {
      "Type": "AWS::SecretsManager::Secret",
      "Properties": {
        "Description": "CloudLens generated origin authentication header",
        "GenerateSecretString": {
          "SecretStringTemplate": "{\"purpose\":\"cloudlens-origin\"}",
          "GenerateStringKey": "header",
          "PasswordLength": 48,
          "ExcludePunctuation": true
        },
        "Tags": [
          {
            "Key": "Project",
            "Value": "CloudLens"
          }
        ]
      }
    }
  },
  "Outputs": {
    "ApplicationURL": {
      "Value": {
        "Fn::Sub": "https://${Distribution.DomainName}"
      },
      "Description": "CloudFront HTTPS application entry; verify deployment before sharing."
    },
    "InstanceId": {
      "Value": {
        "Ref": "Instance"
      },
      "Description": "CloudLens EC2 instance for SSM management."
    },
    "ArtifactBucket": {
      "Value": {
        "Ref": "Artifacts"
      },
      "Description": "Private project artifact and deployment bucket."
    },
    "OriginSecretArn": {
      "Description": "Generated origin secret ARN; its value is never an output.",
      "Value": {
        "Ref": "OriginSecret"
      }
    }
  },
  "Metadata": {
    "AWSToolsMetrics": {
      "AWSAgentToolkit": "aws-cloudformation@3"
    },
    "com.aws.cloudformation.Context": {
      "ref": [
        {
          "at": "docs/deployment.md",
          "has": "single-instance design, retention, origin protection and external Gemini inference"
        }
      ],
      "must": [
        "Only CloudLens resources; private S3; no secrets in user-data; Gemini key injected privately."
      ]
    }
  }
}
