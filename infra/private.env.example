# Copy selected application settings into infra/private/runtime.env on EC2.
# Use the EC2 role: do not put AWS_PROFILE, access keys or root credentials here.
AWS_REGION=ap-south-1
AI_PROVIDER=gemini
GEMINI_API_KEY=REPLACE_PRIVATELY
GEMINI_MODEL_ID=gemini-3.5-flash-lite
EMBEDDING_MODEL_ID=gemini-embedding-001
EMBEDDING_DIMENSIONS=768
S3_BUCKET=REPLACE_WITH_STACK_BUCKET
S3_PREFIX=cloudlens/
ALLOWED_ORIGINS=https://REPLACE_WITH_CLOUDFRONT_DOMAIN
DEMO_PASSWORD=REPLACE_PRIVATELY
SESSION_SECRET=REPLACE_PRIVATELY
MAX_MODEL_CALLS=120
# origin.env contains only ORIGIN_SECRET=the-private-header-value

COOKIE_SECURE=true
DATABASE_PATH=/data/cloudlens.sqlite
INDEX_PATH=/data/index
ARTIFACT_PATH=/data/artifacts
MODEL_TIMEOUT_SECONDS=60
INVESTIGATION_TIMEOUT_SECONDS=180
