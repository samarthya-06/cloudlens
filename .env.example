AWS_REGION=ap-south-1
EMBEDDING_MODEL_ID=gemini-embedding-001
EMBEDDING_DIMENSIONS=768
# AWS_PROFILE=cloudlens
DATABASE_PATH=../runtime/cloudlens.sqlite
INDEX_PATH=../runtime/index
ARTIFACT_PATH=../runtime/artifacts
S3_BUCKET=
S3_PREFIX=cloudlens/
DEMO_PASSWORD=
SESSION_SECRET=
COOKIE_SECURE=false
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
MAX_UPLOAD_BYTES=262144
MAX_MODEL_CALLS=120
MODEL_TIMEOUT_SECONDS=30
INVESTIGATION_TIMEOUT_SECONDS=120
MAX_SESSION_ANALYSES=20
QUEUE_SIZE=4

# AI provider: key stays on the backend, never in VITE_* variables.
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL_ID=gemini-3.5-flash-lite
# Gemini: EMBEDDING_MODEL_ID=gemini-embedding-001; EMBEDDING_DIMENSIONS=768
